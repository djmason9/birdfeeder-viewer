# Copy to .env and fill in. Keep .env private (chmod 600 .env).
# Tip: create a second VicoHome account, share the feeder to it from the app,
# and use that here - VicoHome allows one login at a time per account.
VICO_EMAIL=you@example.com
VICO_PASSWORD=changeme
VICO_REGION=us

# Optional
POLL_SECONDS=120
BACKFILL_HOURS=72
RECORD_SECONDS=20   # length of Auto-record clips (5-120)
HOST=127.0.0.1   # 0.0.0.0 to view from your phone on the same Wi-Fi (anyone on the Wi-Fi can then open live view)
PORT=8080
# VICO_SERIAL=      # pick a camera if the account has several (default: the first one)
# VICO_API_BASE=https://api-us.vicoo.tech   # API host override (older host: https://api-us.vicohome.io)
